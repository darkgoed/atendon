# Copie para .env.test, substitua a credencial e aplique chmod 0600.
# Este controlador administrativo local existe apenas para criar/remover bancos
# descartáveis e nunca é carregado pela API, worker ou migration de produção.
NODE_ENV=test
AI_EVALUATOR_ENABLED=true
CHANGELOG_OPENROUTER_API_KEY=
DATABASE_URL=postgresql://test-only@127.0.0.1:1/atendon_runtime_not_used
PANEL_SEED_PASSWORD=atendon-test-only-password
TEST_DATABASE_URL=postgresql://atendon:change-this-bootstrap-database-password@localhost:5436/atendon_test
TEST_REDIS_URL=redis://localhost:6382/15
