# Copie para .env.migration, substitua todos os valores e aplique chmod 0600.
# Nunca carregue este arquivo no processo da API ou do worker.
POSTGRES_DB=atendon
POSTGRES_USER=atendon
POSTGRES_PASSWORD=change-this-bootstrap-database-password

ATENDON_OWNER_DB_ROLE=atendon_owner
ATENDON_MIGRATION_DB_USER=atendon_migration
ATENDON_MIGRATION_DB_PASSWORD=change-this-migration-database-password
ATENDON_RUNTIME_DB_USER=atendon_app
ATENDON_RUNTIME_DB_PASSWORD=change-this-runtime-database-password

# O entrypoint de migration combina DATABASE_URL de .env com estas variáveis.
MIGRATION_DATABASE_URL=postgresql://atendon_migration:change-this-migration-database-password@localhost:5436/atendon
DATABASE_OWNER_ROLE=atendon_owner
# Conta administrativa usada somente para criar/remover o banco descartável
# atendon_restore_verify_<uuid>. Nunca é carregada pela API ou pelo worker.
RESTORE_ADMIN_DATABASE_URL=postgresql://atendon:change-this-bootstrap-database-password@localhost:5436/postgres
