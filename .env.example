NODE_ENV=development
# O Compose de produção exige ambos; troque "development" por uma tag imutável.
APP_VERSION=1.21.0
DEPLOY_VERSION=development
PORT=3110
# Loopback é o padrão seguro no host. O Compose sobrescreve ambos dentro da imagem.
HOST=127.0.0.1
CONTAINER_RUNTIME=false
# Porta local da infraestrutura. Credenciais de bootstrap, migration e
# provisionamento ficam exclusivamente em .env.migration (chmod 0600).
POSTGRES_PORT=5436
# API/worker carregam somente a credencial DML restrita.
DATABASE_RUNTIME_ROLE=atendon_app
DATABASE_URL=postgresql://atendon_app:change-this-runtime-database-password@localhost:5436/atendon
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=60000
DATABASE_LOCK_TIMEOUT_MS=15000
DATABASE_IDLE_IN_TRANSACTION_SESSION_TIMEOUT_MS=60000
REDIS_PORT=6382
REDIS_URL=redis://localhost:6382
TEST_REDIS_URL=redis://localhost:6382/15
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Em produção, use a URL HTTPS pública do painel.
OPENROUTER_APP_URL=http://localhost:3200
OPENROUTER_APP_NAME=AtendON
OPENROUTER_TIMEOUT_MS=60000
AI_MAX_PROVIDER_REQUESTS_PER_TURN=14
AI_RESERVED_FINAL_REQUESTS=2
AI_MAX_OUTPUT_TOKENS_PER_TURN=8192
AI_MAX_COST_USD_PER_TURN=0.15
AI_HISTORY_MAX_MESSAGES=40
AI_HISTORY_MAX_CHARACTERS=12000
AI_SCHEDULING_MIN_LEAD_MINUTES=15
# Modelo dedicado a transformar áudio em texto antes da resposta da IA principal.
OPENROUTER_TRANSCRIPTION_MODEL=openai/gpt-4o-mini-transcribe
AUDIO_TRANSCRIPTION_MAX_BYTES=26214400
# Ordem de provedores (CSV ou array JSON). Vazio mantém o roteamento automático da OpenRouter.
OPENROUTER_PROVIDER_ORDER=
# Quando há uma ordem, permite tentar os provedores seguintes caso o primário falhe.
OPENROUTER_ALLOW_FALLBACKS=true

# Tripz IA usa um cliente OpenRouter e limites totalmente independentes do atendimento normal.
# Podem permanecer vazios enquanto tripz_ai_v1 estiver desligada. Quando o
# módulo estiver ativo, configure uma chave exclusiva com limite de gasto
# próprio; a chave de changelog nunca é reutilizada pela Tripz IA.
TRIPZ_AI_OPENROUTER_API_KEY=
# Luna Pro é a preferência quando a chave tiver uma rota ZDR. A conta atual
# não tem essa rota; Sonnet 4.6 é o fallback ZDR multimodal validado.
TRIPZ_AI_MODEL=anthropic/claude-sonnet-4.6
# CSV explícito de modelos multimodais aprovados sem pesquisa externa; deve conter TRIPZ_AI_MODEL.
TRIPZ_AI_ALLOWED_MODELS=openai/gpt-5.6-luna-pro,anthropic/claude-sonnet-4.6
# Vazio usa o roteamento padrão da OpenRouter.
TRIPZ_AI_PROVIDER=
TRIPZ_AI_TIMEOUT_MS=60000
TRIPZ_AI_MAX_RETRIES=2
TRIPZ_AI_MAX_PROVIDER_REQUESTS_PER_TURN=3
TRIPZ_AI_MAX_OUTPUT_TOKENS_PER_TURN=4096
TRIPZ_AI_MAX_COST_USD_PER_TURN=0.15
TRIPZ_AI_CONTEXT_MAX_CHARACTERS=60000
TRIPZ_AI_MAX_ATTACHMENTS_PER_TURN=10
TRIPZ_AI_MAX_ATTACHMENT_BYTES=20971520
TRIPZ_AI_MAX_TOTAL_ATTACHMENT_BYTES=41943040
TRIPZ_AI_TEMPERATURE=0.1
TRIPZ_AI_MAX_OUTPUT_TOKENS=4096
TRIPZ_AI_PDF_PARSER_ENGINE=cloudflare-ai
TRIPZ_AI_OPENROUTER_APP_URL=http://localhost:3200
TRIPZ_AI_OPENROUTER_APP_NAME=AtendON Tripz IA
TRIPZ_AI_REQUIRE_ZDR=true

# Zulu sends this validated link only when a Tripz prospect is exclusively
# looking for promotions/cheap trips and is not open to alternatives.
TRIPZ_OFFERS_GROUP_LINK=
TRIPZ_TENANT_SLUG=

# Identidade pública vigente em https://www.tripzturismo.com.br/.
TRIPZ_BRAND_AGENCY_NAME=Tripz Turismo
TRIPZ_BRAND_AGENT_NAME=
TRIPZ_BRAND_PRIMARY_COLOR=#041f3b
TRIPZ_BRAND_SECONDARY_COLOR=#1a6eb5
TRIPZ_BRAND_BACKGROUND_COLOR=#f6f9fd
TRIPZ_BRAND_TEXT_COLOR=#041f3b
TRIPZ_BRAND_MUTED_COLOR=#54677a
TRIPZ_BRAND_PHONE=
TRIPZ_BRAND_EMAIL=
TRIPZ_BRAND_ADDRESS=
# Chave de gerenciamento usada apenas pelo backend para consultar o saldo total em /uso.
# Crie em https://openrouter.ai/settings/management-keys e nunca use esta chave para chamadas de IA.
OPENROUTER_MANAGEMENT_API_KEY=
# A API key da OpenRouter usada APENAS para gerar changelogs públicos é
# configurada no painel (ROOT > /root/versions > Configuração de IA) e fica
# criptografada no banco (changelog_ai_settings) — nunca por variável de ambiente.
DEFAULT_AI_MODEL=openai/gpt-oss-20b:free
DEFAULT_SYSTEM_PROMPT=Você é um atendente prestativo. Responda em português do Brasil.
# Interruptor mestre temporário. Desligado, prompts humanos são publicados sem replay avaliador.
AI_EVALUATOR_ENABLED=true
WHATSAPP_ENABLED=true
EVOLUTION_API_URL=http://localhost:8088
EVOLUTION_PORT=8088
EVOLUTION_PUBLIC_URL=http://localhost:8088
# Use somente caracteres URL-safe: o Compose insere este valor em uma URI PostgreSQL.
EVOLUTION_DB_PASSWORD=change-this-evolution-database-password
EVOLUTION_API_KEY=change-this-evolution-api-key
EVOLUTION_WEBHOOK_URL=http://host.docker.internal:3110
EVOLUTION_WEBHOOK_SECRET=change-this-webhook-header-secret
EVOLUTION_TIMEOUT_MS=15000
JWT_SECRET=change-this-to-at-least-32-random-characters
# Chave independente para dados cifrados. Em rotação, mantenha a anterior temporariamente abaixo.
DATA_ENCRYPTION_KEY=change-this-data-key-to-at-least-32-random-characters
DATA_ENCRYPTION_KEY_PREVIOUS=
PANEL_ORIGIN=http://localhost:3200
PANEL_PUBLIC_URL=http://localhost:3200
# Gere o par uma única vez com `npx web-push generate-vapid-keys`.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:operacoes@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
BACKEND_URL=http://127.0.0.1:3110
# O desenvolvimento local usa /backend; o build de produção deve usar /api.
NEXT_PUBLIC_API_BASE_URL=/backend
TENANT_API_KEY=change-this-tenant-api-key
TRANSFER_NOTIFICATION_WEBHOOK_URL=
# Opcional durante rollout; segredo dedicado com pelo menos 32 caracteres.
TRANSFER_NOTIFICATION_WEBHOOK_HMAC_SECRET=
TRANSFER_NOTIFICATION_CHANNEL=webhook
TRANSFER_NOTIFICATION_TIMEOUT_MS=15000

# Google Meet REST API (sem Google Calendar), usando OAuth 2.0 de usuário.
GOOGLE_MEET_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_MEET_API_BASE_URL=https://meet.googleapis.com
GOOGLE_MEET_TIMEOUT_MS=15000
GOOGLE_MEET_OAUTH_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_MEET_OAUTH_USERINFO_URL=https://openidconnect.googleapis.com/v1/userinfo
GOOGLE_MEET_OAUTH_CLIENT_ID=
GOOGLE_MEET_OAUTH_CLIENT_SECRET=
# Precisa ser idêntica à URI autorizada no cliente OAuth do Google Cloud.
# Produção: https://atendon.alpdash.com.br/api/scheduling/config/google-meet/oauth/callback
GOOGLE_MEET_OAUTH_REDIRECT_URI=http://localhost:3200/backend/scheduling/config/google-meet/oauth/callback

# AtendON Meet / Jitsi (stack isolado em docker-compose.jitsi.yml).
# Master switch de deploy: mantenha false até concluir a validação do stack.
MEET_ENABLED=false
# Gere todos os segredos abaixo de forma independente, por exemplo com `openssl rand -hex 32`.
MEET_PUBLIC_URL=https://meet.atendon.alpdash.com.br
MEET_JWT_APP_ID=atendon
MEET_JWT_SECRET=change-this-meet-jwt-secret-to-at-least-32-random-characters
MEET_JWT_ACCEPTED_ISSUERS=atendon
MEET_JWT_ACCEPTED_AUDIENCES=atendon
# Caminho no host; relativo ao diretório do projeto quando usado pelo Compose/PM2.
MEET_RECORDINGS_DIR=./data/meet-recordings
# Grupo primário do usuário que executa o worker PM2 no host (`id -g deploy`).
MEET_RECORDINGS_HOST_GID=1001
MEET_RECORDING_RETENTION_DAYS=30

# Imagens oficiais fixadas; atualize todos os componentes juntos.
JITSI_IMAGE_VERSION=stable-11031
JITSI_HTTP_PORT=8444
JVB_PORT=10000
# Em produção, os dois valores devem ser o mesmo IP público do VPS.
# JVB_ADVERTISE_IPS é a opção atual; DOCKER_HOST_ADDRESS mantém compatibilidade.
JVB_ADVERTISE_IPS=203.0.113.10
DOCKER_HOST_ADDRESS=203.0.113.10
JICOFO_AUTH_PASSWORD=change-this-jicofo-password-to-a-random-value
JVB_AUTH_PASSWORD=change-this-jvb-password-to-a-random-value
JIBRI_RECORDER_PASSWORD=change-this-jibri-recorder-password-to-a-random-value
JIBRI_XMPP_PASSWORD=change-this-jibri-xmpp-password-to-a-random-value
# Limita uma gravação server-side para proteger o VPS sem GPU.
JIBRI_CPUS=2.0
JIBRI_MEMORY_LIMIT=4g
JIBRI_PENDING_TIMEOUT=90
JICOFO_MAX_MEMORY=1024m
VIDEOBRIDGE_MAX_MEMORY=2048m
PANEL_SEED_EMAIL=admin@atendon.local
PANEL_SEED_PASSWORD="change-me-now"
ROOT_SEED_EMAIL=
ROOT_SEED_PASSWORD=
